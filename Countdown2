<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Countdown</title>
<style>
 body { margin: 0; background: transparent; font-family: "Segoe UI", sans-serif; }
  .wrap { display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; padding: 12px; }
  .boxes { display: flex; gap: 12px; }
  .box { width: 92px; height: 100px; background: #FFFFFF; border-radius: 14px;
         display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
  .num { font-size: 40px; font-weight: 700; color: #4B2A78; line-height: 1; }
  .unit { font-size: 13px; color: #5C566A; }
  .btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px;
         background: #4B2A78; color: #FFFFFF; font-weight: 700; text-decoration: none; border-radius: 999px; }
  .btn:hover { background: #2E1A4D; }
</style>
</head>
<body>
 <div class="wrap">
    <div class="boxes">
      <div class="box"><span class="num" id="d">--</span><span class="unit">days</span></div>
      <div class="box"><span class="num" id="h">--</span><span class="unit">hours</span></div>
      <div class="box"><span class="num" id="m">--</span><span class="unit">mins</span></div>
    </div>
    <a class="btn" href="#" target="_top">Get ready</a>
  </div>
  <script>
  const launch = new Date('2026-11-30T00:00:00+04:00').getTime();
  const pad = n => String(n).padStart(2, '0');

  function tick() {
    const left = launch - Date.now();
    if (left <= 0) {
      document.querySelector('.boxes').innerHTML = '<span class="num">It\'s here!</span>';
      return;
    }
    const mins = Math.floor(left / 60000);
    document.getElementById('d').textContent = Math.floor(mins / 1440);
    document.getElementById('h').textContent = pad(Math.floor(mins / 60) % 24);
    document.getElementById('m').textContent = pad(mins % 60);
  }

  tick();
  setInterval(tick, 15000);
  </script>
</body>
</html>
